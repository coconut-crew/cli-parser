{
	"lsp": {
		"luau-lsp": {
			"settings": {
				"roblox": {
					"enabled": false
				},
				"binary": {
					// "path": "/srv/gh/JohnnyMorganz/luau-lsp/build/luau-lsp"
				},
				"fflags": {
					"enable_by_default": true,
					"enable_new_solver": true,
					"sync": false,
					"override": {
						// "LuauConstraintGraph": "true",
						// "DebugLuauCFG": "true",
						// "LuauIntegerLibrary": "true",
						// "LuauIntegerType2": "true",
						// "LuauUdtfTypeToStringMetamethod": "true",
						"LuauTypeFunctionTableIndexerIsReadOnly": "true",
						"LuauExportValueSyntax": "true",

						"LuauExportValueTypecheck": "true",
						"LuauCyclicRequireTypeInference": "false",
						"LuauCyclicSccWarningThreshold": "0"
					}
				},
				"definitions": ["./lsp/check.d.luau"],
				"luau-lsp": {
					"sourcemap": {
						"enabled": false,
						"autogenerate": false
					},
					"diagnostics": {
						"workspace": true
					},
					"types": {
						"definitionFiles": [],

						"disabledGlobals": [
							"getfenv",
							"setfenv",
							"unpack",
							"loadstring"
						]
					},
					"completion": {
						"enabled": true,
						"imports": {
							"requireStyle": "AlwaysAbsolute",
							"separateGroupsWithLine": false,
							"useConst": true
						},
						"showDeprecatedItems": true
						// "enableFragmentAutocomplete": true
					},
					"index": {
						"enabled": true,
						"maxFiles": 10000
					}
				}
			}
		}
	}
}
